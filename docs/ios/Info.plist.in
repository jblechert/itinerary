<?xml version="1.0" encoding="UTF-8"?>
<!--
    SPDX-FileCopyrightText: 2026 Janis Blechert <janis@blechert.at>
    SPDX-License-Identifier: CC0-1.0

    Draft of the iOS specific Info.plist entries, see PORTING.md. Not used by the build yet.
    ${...} placeholders are to be filled in by CMake/Xcode.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>${BUNDLE_IDENTIFIER}</string>
    <key>CFBundleDisplayName</key>
    <string>${APP_DISPLAY_NAME}</string>
    <key>CFBundleShortVersionString</key>
    <string>${VERSION}</string>
    <key>CFBundleVersion</key>
    <string>${BUILD_NUMBER}</string>

    <!-- permissions, only requested when the feature is used -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Your location is used to find connections from where you are, and for walking directions to the departure stop.</string>
    <key>NSCameraUsageDescription</key>
    <string>The camera is used to scan ticket barcodes.</string>
    <key>NSCalendarsFullAccessUsageDescription</key>
    <string>Calendar events can be imported as trips.</string>

    <!-- map applications for walking directions, needed for canOpenURL() -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>om</string>
        <string>comgooglemaps</string>
    </array>

    <!-- files that can be opened with the app -->
    <key>CFBundleDocumentTypes</key>
    <array>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Wallet Pass</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.apple.pkpass</string>
                <string>com.apple.pkpasses</string>
            </array>
        </dict>
        <dict>
            <key>CFBundleTypeName</key>
            <string>Ticket or booking document</string>
            <key>CFBundleTypeRole</key>
            <string>Viewer</string>
            <key>LSHandlerRank</key>
            <string>Alternate</string>
            <key>LSItemContentTypes</key>
            <array>
                <string>com.adobe.pdf</string>
                <string>public.calendar-event</string>
                <string>public.json</string>
            </array>
        </dict>
    </array>
    <key>LSSupportsOpeningDocumentsInPlace</key>
    <false/>

    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UILaunchStoryboardName</key>
    <string>LaunchScreen</string>
</dict>
</plist>
